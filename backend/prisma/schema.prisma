// STMS — Shantikunjo Tenant Management System
// See docs/REQUIREMENTS.md §5 for the data model rationale.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Auth ─────────────────────────

enum Role {
  ADMIN
  TENANT
}

model User {
  id            String                @id @default(cuid())
  name          String
  email         String                @unique
  passwordHash  String
  role          Role                  @default(ADMIN)
  isActive      Boolean               @default(true)
  lastLoginAt   DateTime?
  tenantId      String?               @unique
  tenant        Tenant?               @relation(fields: [tenantId], references: [id])
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications InvoiceNotification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ───────────────────────── Property & apartments ─────────────────────────

model Property {
  id         String      @id @default(cuid())
  name       String
  address    String?
  floors     Int?
  apartments Apartment[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum Facing {
  NORTH
  NORTH_EAST
  EAST
  SOUTH_EAST
  SOUTH
  SOUTH_WEST
  WEST
  NORTH_WEST
}

model Apartment {
  id                   String         @id @default(cuid())
  propertyId           String
  property             Property       @relation(fields: [propertyId], references: [id])
  number               String
  floor                Int?
  rooms                Int
  toilets              Int
  balconies            Int
  facing               Facing
  sizeSqft             Int?
  meterNo              String?
  defaultRent          Decimal?       @db.Decimal(12, 2)
  defaultServiceCharge Decimal?       @db.Decimal(12, 2)
  underMaintenance     Boolean        @default(false)
  notes                String?
  leases               Lease[]
  meterReadings        MeterReading[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([propertyId, number])
}

// ───────────────────────── Tenants ─────────────────────────

enum Relation {
  SPOUSE
  SON
  DAUGHTER
  FATHER
  MOTHER
  SIBLING
  RELATIVE
  OTHER
}

model Tenant {
  id                    String                @id @default(cuid())
  fullName              String
  nid                   String                @unique
  phone                 String
  email                 String?
  permanentAddress      String
  occupation            String?
  dateOfBirth           DateTime?             @db.Date
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  archivedAt            DateTime?
  familyMembers         FamilyMember[]
  documents             Document[]
  leases                Lease[]
  invoices              Invoice[]
  payments              Payment[]
  notifications         InvoiceNotification[]
  user                  User?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([fullName])
  @@index([phone])
}

model FamilyMember {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  relation  Relation
  phone     String?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

enum DocumentType {
  PHOTO
  LEASE_FORM
  POLICE_VERIFICATION
  NID_COPY
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  tenantId     String
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type         DocumentType
  storageKey   String
  fileName     String
  mimeType     String
  size         Int
  supersededAt DateTime?
  uploadedAt   DateTime     @default(now())

  @@index([tenantId, type])
}

// ───────────────────────── Leases ─────────────────────────

enum LeaseStatus {
  ACTIVE
  NOTICE
  ENDED
}

enum NoticeBy {
  TENANT
  LANDLORD
}

model Lease {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  apartmentId       String
  apartment         Apartment      @relation(fields: [apartmentId], references: [id])
  startDate         DateTime       @db.Date
  endDate           DateTime?      @db.Date
  rent              Decimal        @db.Decimal(12, 2)
  serviceCharge     Decimal        @db.Decimal(12, 2)
  securityDeposit   Decimal        @db.Decimal(12, 2)
  depositReceivedAt DateTime?      @db.Date
  noticeMonths      Int            @default(2)
  status            LeaseStatus    @default(ACTIVE)
  noticeGivenAt     DateTime?      @db.Date
  noticeBy          NoticeBy?
  moveOutDate       DateTime?      @db.Date
  endedAt           DateTime?      @db.Date
  notes             String?
  invoices          Invoice[]
  meterReadings     MeterReading[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([tenantId])
  @@index([apartmentId])
  @@index([status])
}

// ───────────────────────── Electricity ─────────────────────────

model MeterReading {
  id          String       @id @default(cuid())
  apartmentId String
  apartment   Apartment    @relation(fields: [apartmentId], references: [id])
  leaseId     String?
  lease       Lease?       @relation(fields: [leaseId], references: [id])
  period      String // YYYY-MM
  readingDate DateTime     @db.Date
  previous    Decimal      @db.Decimal(12, 2)
  current     Decimal      @db.Decimal(12, 2)
  units       Decimal      @db.Decimal(12, 2)
  amount      Decimal      @db.Decimal(12, 2)
  isReset     Boolean      @default(false)
  isInitial   Boolean      @default(false)
  invoiceLine InvoiceLine?
  createdAt   DateTime     @default(now())

  @@index([apartmentId, readingDate])
  @@index([leaseId, period])
}

// ───────────────────────── Billing ─────────────────────────

enum InvoiceStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum LineType {
  RENT
  SERVICE_CHARGE
  ELECTRICITY
  WATER
  GAS
  OTHER
  DISCOUNT
  ROUNDING // system-managed: brings the invoice total to a whole taka
}

model Invoice {
  id            String                @id @default(cuid())
  number        String                @unique
  leaseId       String
  lease         Lease                 @relation(fields: [leaseId], references: [id])
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id])
  period        String // YYYY-MM
  issueDate     DateTime              @db.Date
  dueDate       DateTime              @db.Date
  total         Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(12, 2)
  status        InvoiceStatus         @default(UNPAID)
  voidReason    String?
  lines         InvoiceLine[]
  allocations   PaymentAllocation[]
  notifications InvoiceNotification[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([leaseId, period])
  @@index([tenantId])
  @@index([period])
  @@index([status, dueDate])
}

model InvoiceLine {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type           LineType
  description    String
  amount         Decimal       @db.Decimal(12, 2)
  meterReadingId String?       @unique
  meterReading   MeterReading? @relation(fields: [meterReadingId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  ROCKET
  CHEQUE
  OTHER
}

model Payment {
  id          String              @id @default(cuid())
  number      String              @unique
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  date        DateTime            @db.Date
  amount      Decimal             @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?
  note        String?
  allocations PaymentAllocation[]
  createdAt   DateTime            @default(now())

  @@index([tenantId])
  @@index([date])
}

model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(12, 2)

  @@index([paymentId])
  @@index([invoiceId])
}

// ───────────────────────── Notifications ─────────────────────────

enum NotificationStatus {
  SENT
  FAILED
}

/// One SMS (or later email) about an invoice. sentTo differs from phone outside production (dev override).
model InvoiceNotification {
  id           String             @id @default(cuid())
  invoiceId    String
  invoice      Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  channel      String             @default("SMS")
  phone        String
  sentTo       String
  message      String
  amount       Decimal            @db.Decimal(12, 2)
  status       NotificationStatus
  providerCode String?
  error        String?
  sentById     String?
  sentBy       User?              @relation(fields: [sentById], references: [id])
  createdAt    DateTime           @default(now())

  @@index([invoiceId, status])
  @@index([tenantId])
}

// ───────────────────────── System ─────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Sequence {
  name  String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
